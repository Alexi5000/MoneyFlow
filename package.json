{
  "name": "moneyflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional budgeting, analytics, and cash-flow dashboard built with React, TypeScript, and FastAPI",
  "author": "Alex Cinovoj",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint --config config/eslint.config.js .",
    "typecheck": "tsc -b",
    "test": "npm run test:frontend-contract && npm run test:backend",
    "test:frontend-contract": "node --test tests/repository-contract.test.mjs",
    "test:backend": "python3 -m pytest src/backend/tests -q",
    "validate:backend": "python3 scripts/validate_backend_contract.py",
    "quality": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.300.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.8.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexi5000/MoneyFlow.git"
  },
  "keywords": [
    "budget-tracker",
    "personal-finance",
    "cash-flow",
    "finance-dashboard",
    "react",
    "typescript",
    "fastapi",
    "python",
    "tailwindcss",
    "full-stack"
  ]
}
