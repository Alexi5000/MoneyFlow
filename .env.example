# MoneyFlow local development configuration
# Copy this file to .env for Vite development. Do not commit the resulting .env file.

# Public backend URL consumed by the React client.
VITE_MONEYFLOW_API_URL=http://127.0.0.1:8000

# Never place API keys, bank credentials, access tokens, or other secrets in VITE_* variables.
# Vite embeds VITE_* values in the browser bundle. Keep third-party provider credentials on a
# future server-side integration boundary rather than in this local-first demo application.
